# ASASI Flow — Environment Variables
# Copy this to .env and fill in your values

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# Project config
PROJECT_NAME=My Project
STACK=Next.js, TypeScript, Prisma
BRAND_VOICE=Direct. Authoritative. No fluff.
AUDIENCE=founders, developers, builders

# Agent directories (used in agents.yaml as ${VAR})
CODEBASE_DIR=/path/to/your/codebase
SCANNER_DIR=/path/to/your/scripts

# Cost cap per command in USD (default: 3.00)
COST_CAP_USD=3.00

# Learning loop — decisions before routing rules update (default: 50)
LEARNING_THRESHOLD=50
